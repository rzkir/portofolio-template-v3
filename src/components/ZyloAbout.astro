---
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
---

<div class="perspective-container bg-[#080808] text-white">
	<div class="relative">
		<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
			<div
				class="absolute right-[-10%] top-[-20%] h-[600px] w-[600px] rounded-full bg-white/5 blur-[120px]"
			></div>
			<div
				class="absolute bottom-[-10%] left-[-10%] h-[500px] w-[500px] rounded-full bg-white/5 blur-[120px]"
			></div>
		</div>

		<div class="relative z-10">
			<Header activeItem="about" />

			<section class="relative flex min-h-[80vh] flex-col justify-center px-8 pt-32">
				<div class="mx-auto w-full max-w-7xl">
					<div class="scroll-zoom">
						<span class="text-muted mb-8 block text-xs font-bold uppercase tracking-[0.5em]">WE ARE ZYLO</span>
						<h1 class="font-serif mb-12 text-[14vw] font-semibold leading-[0.8] tracking-tighter">
							ABOUT <span class="text-outline">US</span>
						</h1>
					</div>

					<div class="grid grid-cols-1 items-start gap-16 md:grid-cols-2">
						<div class="scroll-zoom" style="transition-delay: 150ms;">
							<p class="font-serif text-2xl leading-snug text-gray-300 md:text-3xl">
								We are a collective of visionaries, designers, and strategists dedicated to redefining digital boundaries
								through bold creativity and technical precision.
							</p>
						</div>
						<div class="scroll-zoom" style="transition-delay: 300ms;">
							<p class="max-w-md text-sm leading-relaxed text-gray-500">
								Founded in 2014, Zylo has grown from a small design boutique to a global partner for industry leaders. We
								believe that every pixel tells a story and every interaction is an opportunity for inspiration.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="scroll-zoom mb-20">
						<h2 class="font-serif mb-4 text-5xl">Our Journey</h2>
						<div class="h-px w-24 bg-white/20"></div>
					</div>

					<div class="space-y-32">
						<div class="scroll-zoom grid grid-cols-1 items-center gap-10 md:grid-cols-12">
							<div class="md:col-span-2">
								<span class="text-outline font-serif text-7xl opacity-30">2014</span>
							</div>
							<div class="md:col-span-5">
								<h3 class="font-serif mb-4 text-2xl">The Genesis</h3>
								<p class="text-sm text-gray-400">
									Zylo was born in a small shared workspace in London with a mission to bring high-art aesthetics to the
									digital commercial world.
								</p>
							</div>
							<div
								class="parallax-layer aspect-video overflow-hidden rounded-2xl bg-neutral-900 grayscale transition-all duration-700 hover:grayscale-0 md:col-span-5"
								data-speed="0.05"
							>
								<img
									src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover"
									alt="Office Beginnings"
								/>
							</div>
						</div>

						<div class="scroll-zoom grid grid-cols-1 items-center gap-10 md:grid-cols-12" style="transition-delay: 200ms;">
							<div
								class="parallax-layer order-2 aspect-video overflow-hidden rounded-2xl bg-neutral-900 grayscale transition-all duration-700 hover:grayscale-0 md:order-1 md:col-span-5"
								data-speed="0.05"
							>
								<img
									src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover"
									alt="Team Collaboration"
								/>
							</div>
							<div class="order-1 md:order-2 md:col-span-5 md:col-start-8">
								<h3 class="font-serif mb-4 text-2xl">Global Expansion</h3>
								<p class="text-sm text-gray-400">
									Opening our second studio in Tokyo allowed us to merge Eastern precision with Western experimental design
									philosophies.
								</p>
							</div>
							<div class="order-0 md:order-3 md:col-span-2">
								<span class="text-outline font-serif text-7xl opacity-30">2019</span>
							</div>
						</div>

						<div class="scroll-zoom grid grid-cols-1 items-center gap-10 md:grid-cols-12" style="transition-delay: 400ms;">
							<div class="md:col-span-2">
								<span class="text-outline font-serif text-7xl opacity-30">2024</span>
							</div>
							<div class="md:col-span-5">
								<h3 class="font-serif mb-4 text-2xl">Future Forward</h3>
								<p class="text-sm text-gray-400">
									Today, we lead the industry in 3D web experiences and immersive digital storytelling for the world's most
									innovative brands.
								</p>
							</div>
							<div
								class="parallax-layer aspect-video overflow-hidden rounded-2xl bg-neutral-900 grayscale transition-all duration-700 hover:grayscale-0 md:col-span-5"
								data-speed="0.05"
							>
								<img
									src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover"
									alt="Modern Tech"
								/>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="relative z-10 bg-white/5 px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="scroll-zoom mb-24 flex flex-col items-end justify-between md:flex-row">
						<div class="max-w-2xl">
							<span class="text-muted mb-4 block text-xs font-bold uppercase tracking-widest">THE ARCHITECTS</span>
							<h2 class="font-serif text-6xl">Meet The Visionaries</h2>
						</div>
						<p class="mt-6 max-w-xs text-sm text-gray-400 md:mt-0">
							A diverse team of experts united by a shared passion for aesthetic excellence.
						</p>
					</div>

					<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
						<div class="scroll-zoom group">
							<div class="hover-card relative mb-6 aspect-3/4 overflow-hidden rounded-3xl">
								<img
									src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
									alt="Julian Varez"
								/>
							</div>
							<h3 class="font-serif text-xl">Julian Varez</h3>
							<p class="text-muted text-xs font-bold uppercase tracking-widest">Founder & Creative Director</p>
						</div>

						<div class="scroll-zoom group" style="transition-delay: 100ms;">
							<div class="hover-card relative mb-6 aspect-3/4 overflow-hidden rounded-3xl">
								<img
									src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
									alt="Elena Rossi"
								/>
							</div>
							<h3 class="font-serif text-xl">Elena Rossi</h3>
							<p class="text-muted text-xs font-bold uppercase tracking-widest">Head of Design</p>
						</div>

						<div class="scroll-zoom group" style="transition-delay: 200ms;">
							<div class="hover-card relative mb-6 aspect-3/4 overflow-hidden rounded-3xl">
								<img
									src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
									alt="Marcus Chen"
								/>
							</div>
							<h3 class="font-serif text-xl">Marcus Chen</h3>
							<p class="text-muted text-xs font-bold uppercase tracking-widest">Lead Engineer</p>
						</div>

						<div class="scroll-zoom group" style="transition-delay: 300ms;">
							<div class="hover-card relative mb-6 aspect-3/4 overflow-hidden rounded-3xl">
								<img
									src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=800"
									class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
									alt="Sarah Jenkins"
								/>
							</div>
							<h3 class="font-serif text-xl">Sarah Jenkins</h3>
							<p class="text-muted text-xs font-bold uppercase tracking-widest">Brand Strategist</p>
						</div>
					</div>
				</div>
			</section>

			<section class="perspective-container px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
						<div class="scroll-zoom">
							<div class="glass h-full rounded-[2.5rem] p-12">
								<iconify-icon icon="lucide:flame" class="mb-8 text-4xl text-white"></iconify-icon>
								<h3 class="font-serif mb-6 text-2xl">Bold Innovation</h3>
								<p class="text-sm leading-relaxed text-gray-400">
									We don't follow trends; we set them. Our team is encouraged to break the rules to discover what's truly
									possible.
								</p>
							</div>
						</div>
						<div class="scroll-zoom" style="transition-delay: 150ms;">
							<div class="glass h-full rounded-[2.5rem] p-12">
								<iconify-icon icon="lucide:layers" class="mb-8 text-4xl text-white"></iconify-icon>
								<h3 class="font-serif mb-6 text-2xl">Absolute Quality</h3>
								<p class="text-sm leading-relaxed text-gray-400">
									Excellence is in the details. From the first sketch to the final deployment, we obsess over every
									interaction.
								</p>
							</div>
						</div>
						<div class="scroll-zoom" style="transition-delay: 300ms;">
							<div class="glass h-full rounded-[2.5rem] p-12">
								<iconify-icon icon="lucide:users" class="mb-8 text-4xl text-white"></iconify-icon>
								<h3 class="font-serif mb-6 text-2xl">Radical Empathy</h3>
								<p class="text-sm leading-relaxed text-gray-400">
									We design for humans. Understanding the user's emotional journey is the core of our strategic approach.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="flex flex-col gap-20 md:flex-row">
						<div class="scroll-zoom md:w-1/3">
							<h2 class="font-serif mb-8 text-5xl">Our Capabilities</h2>
							<p class="mb-10 text-gray-500">
								A comprehensive ecosystem of services to elevate your brand from concept to culture.
							</p>
							<a href="#" class="inline-flex items-center gap-4 text-xs font-bold uppercase tracking-widest">
								<span class="glass flex h-10 w-10 items-center justify-center rounded-full">
									<iconify-icon icon="lucide:download"></iconify-icon>
								</span>
								Download Deck
							</a>
						</div>

						<div class="scroll-zoom grid grid-cols-1 gap-x-12 gap-y-16 sm:grid-cols-2 md:w-2/3" style="transition-delay: 200ms;">
							<div class="border-t border-white/10 pt-8">
								<span class="text-muted mb-4 block text-[10px] font-bold tracking-widest">01.</span>
								<h4 class="font-serif mb-4 text-xl">Visual Identity</h4>
								<p class="text-xs leading-relaxed text-gray-500">
									Brand architecture, logo design, typography, and motion guidelines.
								</p>
							</div>
							<div class="border-t border-white/10 pt-8">
								<span class="text-muted mb-4 block text-[10px] font-bold tracking-widest">02.</span>
								<h4 class="font-serif mb-4 text-xl">Digital Product</h4>
								<p class="text-xs leading-relaxed text-gray-500">
									UX/UI design for mobile apps, SaaS platforms, and enterprise solutions.
								</p>
							</div>
							<div class="border-t border-white/10 pt-8">
								<span class="text-muted mb-4 block text-[10px] font-bold tracking-widest">03.</span>
								<h4 class="font-serif mb-4 text-xl">Immersive Web</h4>
								<p class="text-xs leading-relaxed text-gray-500">
									3D web design, interactive storytelling, and high-performance development.
								</p>
							</div>
							<div class="border-t border-white/10 pt-8">
								<span class="text-muted mb-4 block text-[10px] font-bold tracking-widest">04.</span>
								<h4 class="font-serif mb-4 text-xl">Creative Strategy</h4>
								<p class="text-xs leading-relaxed text-gray-500">
									Market analysis, user research, and long-term brand positioning.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="relative overflow-hidden px-8 py-48 text-center">
				<div class="scroll-zoom mx-auto max-w-4xl">
					<h2 class="font-serif mb-12 text-7xl leading-none tracking-tighter md:text-9xl">
						LET'S <span class="text-outline italic">TALK</span>
					</h2>
					<p class="mb-12 text-gray-400">Ready to start your journey into excellence? Reach out to our studio today.</p>
					<a
						href="/#contact"
						id="cta-about-contact-btn"
						class="inline-block rounded-full bg-white px-12 py-5 font-black uppercase tracking-widest text-black transition-transform hover:scale-110"
					>
						Get in Touch
					</a>
				</div>

				<div
					class="glass parallax-layer absolute left-0 top-1/2 flex h-40 w-40 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full opacity-20"
					data-speed="0.1"
				></div>
				<div
					class="glass parallax-layer absolute bottom-1/4 right-0 flex h-60 w-60 translate-x-1/3 items-center justify-center rounded-full opacity-10"
					data-speed="-0.05"
				></div>
			</section>
		</div>
	</div>

	<Footer />
</div>

<script is:inline>
	let ticking = false;
	const activated = new WeakSet();

	function activate(el, delayMs = 0) {
		if (!(el instanceof HTMLElement)) return;
		if (activated.has(el)) return;
		activated.add(el);
		el.style.transitionDelay = `${delayMs}ms`;
		el.classList.add('active');
	}

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) activate(entry.target, 0);
			});
		},
		{ threshold: 0.05, rootMargin: '0px 0px -50px 0px' },
	);

	document.querySelectorAll('.scroll-zoom').forEach((el) => revealObserver.observe(el));

	function revealOnLoad() {
		const vh = window.innerHeight;
		const els = Array.from(document.querySelectorAll('.scroll-zoom'));
		let i = 0;
		for (const el of els) {
			const rect = el.getBoundingClientRect();
			const inView = rect.bottom > 0 && rect.top < vh * 0.95;
			if (!inView) continue;
			activate(el, i * 70);
			i += 1;
		}
	}

	function update3D() {
		const scrollY = window.pageYOffset;
		const vh = window.innerHeight;

		document.querySelectorAll('.scroll-zoom').forEach((el) => {
			const rect = el.getBoundingClientRect();

			let progress = (vh - rect.top) / (vh * 0.7);
			progress = Math.min(Math.max(progress, 0), 1);

			const scale = 0.7 + progress * 0.3;
			const z = -500 + progress * 500;
			const y = 100 * (1 - progress);
			const rot = 15 * (1 - progress);

			let transform = `perspective(1500px) translate3d(0, ${y}px, ${z}px) scale(${scale}) rotateX(${rot}deg)`;

			if (el.classList.contains('scroll-depth')) {
				const depth = Number.parseFloat(el.getAttribute('data-depth')) || 0.1;
				transform += ` translate3d(${scrollY * depth}px, 0, 0)`;
			}

			if (el.classList.contains('scroll-rotate')) {
				const scrollPercent = (vh - rect.top) / vh;
				if (scrollPercent > 0 && scrollPercent < 2) {
					const maxRotate = Number.parseFloat(el.getAttribute('data-rotate')) || 20;
					const currentRotate = (scrollPercent - 0.5) * maxRotate;
					const zoomScale = 0.8 + scrollPercent * 0.2;
					transform += ` scale(${zoomScale}) perspective(1000px) rotateX(${currentRotate}deg)`;
				}
			}

			el.style.transform = transform;
			el.style.opacity = Math.min(progress * 1.5, 1);
		});

		document.querySelectorAll('.parallax-layer').forEach((layer) => {
			const speed = Number.parseFloat(layer.getAttribute('data-speed')) || 0.1;
			layer.style.transform = `translate3d(0, ${scrollY * speed}px, 0)`;
		});

		const nav = document.querySelector('[data-site-nav]');
		const navInner = document.querySelector('[data-site-nav-inner]');
		if (nav instanceof HTMLElement && navInner instanceof HTMLElement) {
			if (scrollY > 100) {
				nav.classList.remove('mix-blend-difference');
				nav.classList.add('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.remove('py-10');
				navInner.classList.add('py-6');
			} else {
				nav.classList.add('mix-blend-difference');
				nav.classList.remove('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.add('py-10');
				navInner.classList.remove('py-6');
			}
		}

		ticking = false;
	}

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(update3D);
			ticking = true;
		}
	});

	requestAnimationFrame(revealOnLoad);
	update3D();
</script>

