								<img
									src="https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&q=80&w=800"
									alt="Blog"
									class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
								/>
								<div class="absolute left-6 top-6">
									<span class="rounded-full bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-black">
										Design
									</span>
								</div>
							</div>
							<h3 class="font-serif mb-4 text-3xl group-hover:underline">Minimalism: The Art of Knowing What to Remove</h3>
							<p class="mb-6 text-sm text-gray-500">
								Exploring why the most impactful interfaces are often the ones with the fewest elements.
							</p>
							<span class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
								Read Article <iconify-icon icon="lucide:arrow-right"></iconify-icon>
							</span>
						</a>

						<a
							href="#"
							class="scroll-zoom group block"
							data-post
							data-category="trends"
							data-title="Web Animation API vs Framer Motion in 2024"
							data-description="A deep dive into which animation library reigns supreme for modern high-end web experiences."
						>
							<div class="relative mb-8 aspect-3/2 overflow-hidden rounded-3xl transition-transform duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]">
								<img
									src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=800"
									alt="Blog"
									class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
								/>
								<div class="absolute left-6 top-6">
									<span class="rounded-full bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-black">
										Trends
									</span>
								</div>
							</div>
							<h3 class="font-serif mb-4 text-3xl group-hover:underline">Web Animation API vs Framer Motion in 2024</h3>
							<p class="mb-6 text-sm text-gray-500">
								A deep dive into which animation library reigns supreme for modern high-end web experiences.
							</p>
							<span class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
								Read Article <iconify-icon icon="lucide:arrow-right"></iconify-icon>
							</span>
						</a>

						<a
							href="#"
							class="scroll-zoom group block"
							style="transition-delay: 100ms;"
							data-post
							data-category="process"
							data-title="The Real Business Value of Design Thinking"
							data-description="Moving beyond aesthetics to solve actual business problems and improve conversion rates."
						>
							<div class="relative mb-8 aspect-3/2 overflow-hidden rounded-3xl transition-transform duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]">
								<img
									src="https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&q=80&w=800"
									alt="Blog"
									class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
								/>
								<div class="absolute left-6 top-6">
									<span class="rounded-full bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-black">
										Process
									</span>
								</div>
							</div>
							<h3 class="font-serif mb-4 text-3xl group-hover:underline">The Real Business Value of Design Thinking</h3>
							<p class="mb-6 text-sm text-gray-500">
								Moving beyond aesthetics to solve actual business problems and improve conversion rates.
							</p>
							<span class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
								Read Article <iconify-icon icon="lucide:arrow-right"></iconify-icon>
							</span>
						</a>

						<a
							href="#"
							class="scroll-zoom group block"
							style="transition-delay: 200ms;"
							data-post
							data-category="design"
							data-title="Typography as the Soul of Digital Products"
							data-description="Choosing the right font pairings to establish brand identity and emotional connection."
						>
							<div class="relative mb-8 aspect-3/2 overflow-hidden rounded-3xl transition-transform duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]">
								<img
									src="https://images.unsplash.com/photo-1543167601-5219353412c0?auto=format&fit=crop&q=80&w=800"
									alt="Blog"
									class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
								/>
								<div class="absolute left-6 top-6">
									<span class="rounded-full bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-black">
										Design
									</span>
								</div>
							</div>
							<h3 class="font-serif mb-4 text-3xl group-hover:underline">Typography as the Soul of Digital Products</h3>
							<p class="mb-6 text-sm text-gray-500">
								Choosing the right font pairings to establish brand identity and emotional connection.
							</p>
							<span class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
								Read Article <iconify-icon icon="lucide:arrow-right"></iconify-icon>
							</span>
						</a>
					</div>

					<div class="scroll-zoom mt-32 flex justify-center">
						<div class="flex items-center gap-4">
							<button
								id="prev-page-btn"
								type="button"
								class="flex h-14 w-14 items-center justify-center rounded-full border border-white/10 transition-all hover:bg-white hover:text-black"
							>
								<iconify-icon icon="lucide:chevron-left"></iconify-icon>
							</button>
							<div class="flex items-center gap-2">
								<span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-xs font-black text-black">1</span>
								<span class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-xs font-black transition-all hover:bg-white/10">2</span>
								<span class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-xs font-black transition-all hover:bg-white/10">3</span>
							</div>
							<button
								id="next-page-btn"
								type="button"
								class="flex h-14 w-14 items-center justify-center rounded-full border border-white/10 transition-all hover:bg-white hover:text-black"
