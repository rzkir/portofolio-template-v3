---
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
---

<div class="perspective-container bg-[#080808] text-white">
	<div class="relative">
		<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
			<div class="absolute right-[-10%] top-[-20%] h-[600px] w-[600px] rounded-full bg-white/5 blur-[120px]"></div>
			<div class="absolute bottom-[-10%] left-[-10%] h-[500px] w-[500px] rounded-full bg-white/5 blur-[120px]"></div>
		</div>

		<div class="relative z-10">
			<Header activeItem="blog" />

			<section class="relative overflow-hidden px-8 pb-24 pt-48">
				<div class="mx-auto w-full max-w-7xl">
					<div class="scroll-zoom mb-12">
						<span class="text-muted mb-4 block text-xs font-black uppercase tracking-[0.5em]">
							EDITORIAL SELECTION
						</span>
						<h1 class="font-serif text-8xl font-semibold leading-[0.8] tracking-tighter md:text-[10vw]">
							ARTI<span class="text-outline">CLES</span>
						</h1>
					</div>

					<div class="scroll-zoom relative" style="transition-delay: 200ms;">
						<a href="#" id="featured-blog-link" class="group block">
							<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
								<div class="lg:col-span-7">
									<div class="relative aspect-[16/10] overflow-hidden rounded-[2.5rem] bg-neutral-900">
										<img
											src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=1600"
											alt="Featured Article"
											class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
										/>
										<div class="absolute left-8 top-8">
											<span class="glass rounded-full px-6 py-2 text-[10px] font-black uppercase tracking-widest">
												Featured
											</span>
										</div>
									</div>
								</div>

								<div class="flex flex-col justify-center lg:col-span-5">
									<div class="mb-6 flex items-center gap-4">
										<span class="text-muted text-xs font-bold uppercase tracking-widest">Design Thinking</span>
										<span class="h-1 w-1 rounded-full bg-white/20"></span>
										<span class="text-muted text-xs font-bold uppercase tracking-widest">Oct 24, 2024</span>
									</div>
									<h2 class="font-serif mb-8 text-5xl leading-[1.1] transition-colors group-hover:text-white/70 md:text-6xl">
										The Future of Neomorphism in Interface Design
									</h2>
									<p class="mb-10 max-w-md text-lg leading-relaxed text-gray-400">
										Exploring how the subtle play of shadows and light is evolving into a more functional and accessible
										design language for next-gen spatial OS.
									</p>
									<div class="flex items-center gap-4">
										<div class="h-12 w-12 overflow-hidden rounded-full bg-neutral-800">
											<img
												src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=200"
												alt="Author"
												class="h-full w-full object-cover"
											/>
										</div>
										<div>
											<p class="text-xs font-black uppercase tracking-widest">Marcus Vancy</p>
											<p class="text-muted text-[10px]">8 min read</p>
										</div>
									</div>
								</div>
							</div>
						</a>
					</div>
				</div>
			</section>

			<section class="px-8 py-24">
				<div class="mx-auto max-w-7xl">
					<div class="scroll-zoom mb-20 flex flex-col items-center justify-between gap-8 md:flex-row">
						<div class="flex flex-wrap items-center gap-3">
