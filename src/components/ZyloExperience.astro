---
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
---

<div class="perspective-container min-h-screen bg-[#080808] text-white">
	<div class="relative">
		<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
			<div
				class="absolute right-[-10%] top-[-20%] h-[600px] w-[600px] rounded-full bg-white/5 blur-[120px]"
			></div>
			<div
				class="absolute bottom-[-10%] left-[-10%] h-[500px] w-[500px] rounded-full bg-white/5 blur-[120px]"
			></div>
		</div>

		<div class="relative z-10">
			<Header activeItem="experience" />

			<header class="relative overflow-hidden px-8 pb-24 pt-48">
				<div class="mx-auto w-full max-w-7xl">
					<div class="scroll-zoom">
						<span class="text-muted mb-8 block text-xs font-black uppercase tracking-[0.5em]">
							RESUME & CAREER
						</span>
						<h1 class="font-serif mb-12 text-8xl font-semibold leading-[0.8] tracking-tighter md:text-[12vw]">
							EXPERI<span class="text-outline">ENCE</span>
						</h1>
					</div>
					<div class="scroll-zoom max-w-xl" style="transition-delay: 200ms;">
						<p class="text-xl leading-relaxed text-gray-400">
							A decade of bridging the gap between artistic vision and technical implementation, helping global
							brands reach their full digital potential.
						</p>
					</div>
				</div>
			</header>

			<section class="relative px-8 py-32">
				<div class="relative mx-auto max-w-7xl">
					<div class="timeline-line absolute bottom-0 left-4 top-0 hidden -translate-x-1/2 md:left-1/2 md:block"></div>

					<div class="space-y-32">
						<div class="relative flex flex-col items-center justify-between gap-12 md:flex-row">
							<div class="scroll-zoom order-2 w-full md:order-1 md:w-[45%]">
								<div
									class="glass group rounded-[2.5rem] border border-white/10 p-10 transition-all hover:border-white/20"
								>
									<span class="text-muted mb-4 block text-[10px] font-black uppercase tracking-widest">
										Jan 2022 — Present
									</span>
									<h3 class="font-serif mb-2 text-3xl">Lead Product Designer</h3>
									<p class="mb-6 text-lg font-bold uppercase tracking-widest text-white/40">Creative Hub Studio</p>
									<p class="mb-8 text-sm leading-relaxed text-gray-400">
										Leading a team of 12 designers to deliver high-impact digital products for Fortune 500 clients.
										Specialized in architecting scalable design systems and mentoring junior talent.
									</p>
									<div class="flex flex-wrap gap-3">
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Design Systems</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Leadership</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">UX Strategy</span>
									</div>
								</div>
							</div>
							<div class="absolute left-4 z-10 hidden h-4 w-4 -translate-x-1/2 rounded-full bg-white md:left-1/2 md:block">
								<div class="absolute inset-0 animate-pulse rounded-full bg-white blur-sm"></div>
							</div>
							<div class="scroll-zoom order-1 w-full text-left md:order-2 md:w-[45%]" style="transition-delay: 150ms;">
								<h4 class="text-outline hidden font-serif text-5xl opacity-20 md:block">01</h4>
								<div class="md:hidden">
									<p class="font-serif mb-2 text-xl">Lead Product Designer</p>
									<p class="text-muted text-xs font-bold uppercase tracking-widest">Creative Hub Studio</p>
								</div>
							</div>
						</div>

						<div class="relative flex flex-col items-center justify-between gap-12 md:flex-row">
							<div class="scroll-zoom hidden w-full text-right md:block md:w-[45%]">
								<h4 class="text-outline font-serif text-5xl opacity-20">02</h4>
							</div>
							<div class="absolute left-4 z-10 hidden h-4 w-4 -translate-x-1/2 rounded-full bg-white/20 md:left-1/2 md:block"></div>
							<div class="scroll-zoom w-full md:w-[45%]" style="transition-delay: 200ms;">
								<div
									class="glass group rounded-[2.5rem] border border-white/10 p-10 transition-all hover:border-white/20"
								>
									<span class="text-muted mb-4 block text-[10px] font-black uppercase tracking-widest">
										Aug 2019 — Dec 2021
									</span>
									<h3 class="font-serif mb-2 text-3xl">Senior UI/UX Engineer</h3>
									<p class="mb-6 text-lg font-bold uppercase tracking-widest text-white/40">TechStack Solutions</p>
									<p class="mb-8 text-sm leading-relaxed text-gray-400">
										Bridged the gap between design and engineering. Built interactive dashboard components and led the
										migration to a component-driven development workflow using React.
									</p>
									<div class="flex flex-wrap gap-3">
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Frontend Dev</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Prototyping</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">React.js</span>
									</div>
								</div>
							</div>
						</div>

						<div class="relative flex flex-col items-center justify-between gap-12 md:flex-row">
							<div class="scroll-zoom w-full md:w-[45%]">
								<div
									class="glass group rounded-[2.5rem] border border-white/10 p-10 transition-all hover:border-white/20"
								>
									<span class="text-muted mb-4 block text-[10px] font-black uppercase tracking-widest">
										May 2017 — July 2019
									</span>
									<h3 class="font-serif mb-2 text-3xl">UI Designer</h3>
									<p class="mb-6 text-lg font-bold uppercase tracking-widest text-white/40">Pixel Perfect Studio</p>
									<p class="mb-8 text-sm leading-relaxed text-gray-400">
										Crafted visual identities and mobile interfaces for early-stage startups. Focused on high-fidelity
										visual design and brand consistency across platforms.
									</p>
									<div class="flex flex-wrap gap-3">
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Visual Design</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Branding</span>
										<span class="glass rounded-full px-3 py-1 text-[10px] font-bold">Mobile UI</span>
									</div>
								</div>
							</div>
							<div class="absolute left-4 z-10 hidden h-4 w-4 -translate-x-1/2 rounded-full bg-white/20 md:left-1/2 md:block"></div>
							<div class="scroll-zoom hidden w-full md:block md:w-[45%]" style="transition-delay: 300ms;">
								<h4 class="text-outline font-serif text-5xl opacity-20">03</h4>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="bg-white/5 px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="scroll-zoom mb-20">
						<span class="text-muted mb-4 block text-xs font-black uppercase tracking-[0.5em]">TOOLBOX</span>
						<h2 class="font-serif text-6xl">Skills & Expertise</h2>
					</div>

					<div class="grid grid-cols-1 gap-16 md:grid-cols-3">
						<div class="scroll-zoom">
							<h3 class="font-serif mb-8 border-b border-white/10 pb-4 text-2xl">Design</h3>
							<div class="flex flex-wrap gap-4">
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">UI/UX Design</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Design Systems</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Interaction Design</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Branding</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Motion Graphics</span>
							</div>
						</div>
						<div class="scroll-zoom" style="transition-delay: 150ms;">
							<h3 class="font-serif mb-8 border-b border-white/10 pb-4 text-2xl">Technical</h3>
							<div class="flex flex-wrap gap-4">
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">React / Next.js</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Tailwind CSS</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">GSAP Animation</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">TypeScript</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Node.js</span>
							</div>
						</div>
						<div class="scroll-zoom" style="transition-delay: 300ms;">
							<h3 class="font-serif mb-8 border-b border-white/10 pb-4 text-2xl">Software</h3>
							<div class="flex flex-wrap gap-4">
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Figma</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Adobe Creative Suite</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Framer</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">Webflow</span>
								<span class="skill-tag glass rounded-full px-6 py-3 text-sm font-bold">VS Code</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="px-8 py-40">
				<div class="mx-auto grid max-w-7xl grid-cols-1 gap-24 lg:grid-cols-2">
					<div class="scroll-zoom">
						<h2 class="font-serif mb-12 text-5xl">Education</h2>
						<div class="space-y-12">
							<div class="group">
								<p class="text-muted mb-2 text-xs font-black uppercase tracking-widest">2013 — 2017</p>
								<h3 class="font-serif mb-1 text-2xl transition-colors group-hover:text-white/60">
									Bachelor of Fine Arts in Digital Design
								</h3>
								<p class="text-sm text-gray-500">University of Arts & Technology, New York</p>
							</div>
							<div class="group">
								<p class="text-muted mb-2 text-xs font-black uppercase tracking-widest">2011 — 2013</p>
								<h3 class="font-serif mb-1 text-2xl transition-colors group-hover:text-white/60">
									Visual Communications Diploma
								</h3>
								<p class="text-sm text-gray-500">Creative Arts Academy</p>
							</div>
						</div>
					</div>

					<div class="scroll-zoom" style="transition-delay: 200ms;">
						<h2 class="font-serif mb-12 text-5xl">Certifications</h2>
						<div class="space-y-12">
							<div class="group flex items-start gap-6">
								<div class="glass flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl">
									<iconify-icon icon="lucide:award" class="text-2xl"></iconify-icon>
								</div>
								<div>
									<p class="text-muted mb-1 text-xs font-black uppercase tracking-widest">2023</p>
									<h3 class="font-serif mb-1 text-2xl transition-colors group-hover:text-white/60">
										Google UX Design Professional
									</h3>
									<p class="text-sm text-gray-500">Coursera Specialization</p>
								</div>
							</div>
							<div class="group flex items-start gap-6">
								<div class="glass flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl">
									<iconify-icon icon="lucide:award" class="text-2xl"></iconify-icon>
								</div>
								<div>
									<p class="text-muted mb-1 text-xs font-black uppercase tracking-widest">2022</p>
									<h3 class="font-serif mb-1 text-2xl transition-colors group-hover:text-white/60">
										Advanced Interaction Design
									</h3>
									<p class="text-sm text-gray-500">Nielsen Norman Group (NN/g)</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>

	<Footer />
</div>

<script is:inline>
	let ticking = false;
	const activated = new WeakSet();

	function activate(el, delayMs = 0) {
		if (!(el instanceof HTMLElement)) return;
		if (activated.has(el)) return;
		activated.add(el);
		el.style.transitionDelay = `${delayMs}ms`;
		el.classList.add('active');
	}

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) activate(entry.target, 0);
			});
		},
		{ threshold: 0.05, rootMargin: '0px 0px -50px 0px' },
	);

	document.querySelectorAll('.scroll-zoom').forEach((el) => revealObserver.observe(el));

	function revealOnLoad() {
		const vh = window.innerHeight;
		const els = Array.from(document.querySelectorAll('.scroll-zoom'));
		let i = 0;
		for (const el of els) {
			const rect = el.getBoundingClientRect();
			const inView = rect.bottom > 0 && rect.top < vh * 0.95;
			if (!inView) continue;
			activate(el, i * 70);
			i += 1;
		}
	}

	function update3D() {
		const scrollY = window.pageYOffset;
		const vh = window.innerHeight;

		document.querySelectorAll('.scroll-zoom').forEach((el) => {
			const rect = el.getBoundingClientRect();

			let progress = (vh - rect.top) / (vh * 0.7);
			progress = Math.min(Math.max(progress, 0), 1);

			const scale = 0.7 + progress * 0.3;
			const z = -500 + progress * 500;
			const y = 100 * (1 - progress);
			const rot = 15 * (1 - progress);

			let transform = `perspective(1500px) translate3d(0, ${y}px, ${z}px) scale(${scale}) rotateX(${rot}deg)`;

			if (el.classList.contains('scroll-depth')) {
				const depth = Number.parseFloat(el.getAttribute('data-depth')) || 0.1;
				const xOffset = scrollY * depth;
				transform += ` translate3d(${xOffset}px, 0, 0)`;
			}

			if (el.classList.contains('scroll-rotate')) {
				const scrollPercent = (vh - rect.top) / vh;
				if (scrollPercent > 0 && scrollPercent < 2) {
					const maxRotate = Number.parseFloat(el.getAttribute('data-rotate')) || 20;
					const currentRotate = (scrollPercent - 0.5) * maxRotate;
					const zoomScale = 0.8 + scrollPercent * 0.2;
					transform += ` scale(${zoomScale}) perspective(1000px) rotateX(${currentRotate}deg)`;
				}
			}

			el.style.transform = transform;
			el.style.opacity = Math.min(progress * 1.5, 1);
		});

		document.querySelectorAll('.parallax-layer').forEach((layer) => {
			const speed = Number.parseFloat(layer.getAttribute('data-speed')) || 0.1;
			layer.style.transform = `translate3d(0, ${scrollY * speed}px, 0)`;
		});

		const nav = document.querySelector('[data-site-nav]');
		const navInner = document.querySelector('[data-site-nav-inner]');
		if (nav instanceof HTMLElement && navInner instanceof HTMLElement) {
			if (scrollY > 100) {
				nav.classList.remove('mix-blend-difference');
				nav.classList.add('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.remove('py-10');
				navInner.classList.add('py-6');
			} else {
				nav.classList.add('mix-blend-difference');
				nav.classList.remove('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.add('py-10');
				navInner.classList.remove('py-6');
			}
		}

		ticking = false;
	}

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(update3D);
			ticking = true;
		}
	});

	// initial reveal (stagger)
	requestAnimationFrame(revealOnLoad);
	update3D();
</script>

