---
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
---

<div class="perspective-container flex min-h-screen flex-col bg-[#080808] text-white">
	<div class="relative flex-1">
		<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
			<div class="absolute right-[-10%] top-[-20%] h-[600px] w-[600px] rounded-full bg-white/5 blur-[120px]"></div>
			<div class="absolute bottom-[-10%] left-[-10%] h-[500px] w-[500px] rounded-full bg-white/5 blur-[120px]"></div>
		</div>

		<div class="relative z-10">
			<Header activeItem="works" />

			<header class="relative overflow-hidden px-8 pb-20 pt-48">
				<div class="mx-auto w-full max-w-7xl">
					<div class="scroll-zoom">
						<span class="text-muted mb-6 block text-xs font-black uppercase tracking-[0.5em]">OUR PORTFOLIO</span>
						<h1 class="font-serif mb-12 text-8xl font-semibold leading-[0.8] tracking-tighter md:text-[14vw]">
							WORKS<span class="text-outline">_24</span>
						</h1>
					</div>

					<div class="mt-12 flex flex-col items-end justify-between gap-12 md:flex-row">
						<div class="scroll-zoom max-w-xl" style="transition-delay: 150ms;">
							<p class="text-xl font-light leading-relaxed text-gray-400">
								Exploration of digital boundaries through award-winning design and technology solutions. Each project
								represents a unique journey of innovation.
							</p>
						</div>

						<div class="scroll-zoom flex flex-wrap gap-4" style="transition-delay: 300ms;">
							<button
								class="filter-btn glass active flex items-center gap-3 rounded-full px-6 py-3 text-[10px] font-bold uppercase tracking-widest"
								type="button"
								data-filter="all"
							>
								All Projects <span class="opacity-40" data-filter-count>08</span>
							</button>
							<button
								class="filter-btn glass flex items-center gap-3 rounded-full px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-white/10"
								type="button"
								data-filter="fintech"
							>
								Fintech <span class="opacity-40" data-filter-count>02</span>
							</button>
							<button
								class="filter-btn glass flex items-center gap-3 rounded-full px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-white/10"
								type="button"
								data-filter="saas"
							>
								SaaS <span class="opacity-40" data-filter-count>03</span>
							</button>
							<button
								class="filter-btn glass flex items-center gap-3 rounded-full px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-white/10"
								type="button"
								data-filter="design"
							>
								Design <span class="opacity-40" data-filter-count>03</span>
							</button>
						</div>
					</div>
				</div>
			</header>

			<main class="relative z-10 px-8 py-20">
				<div class="mx-auto max-w-7xl">
					<div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12" data-project-grid>
						<div class="scroll-zoom lg:col-span-8" data-project data-category="fintech">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1487014679447-9f8336841d58?auto=format&fit=crop&q=80&w=1600"
											alt="Etherium Financial Ecosystem"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Fintech App • 2024</p>
										<h3 class="font-serif text-4xl">Etherium Financial Ecosystem</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-4" style="transition-delay: 100ms;" data-project data-category="design">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&q=80&w=800"
											alt="Modular Workspace"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Modular Space • 2023</p>
										<h3 class="font-serif text-4xl">Modular Workspace</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-4" style="transition-delay: 200ms;" data-project data-category="saas">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=800"
											alt="Digital Pulse Dashboard"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Analytics • 2024</p>
										<h3 class="font-serif text-4xl">Digital Pulse Dashboard</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-8" style="transition-delay: 300ms;" data-project data-category="saas">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&q=80&w=1600"
											alt="Nova Retail Platform"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">E-commerce • 2023</p>
										<h3 class="font-serif text-4xl">Nova Retail Platform</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-6" style="transition-delay: 400ms;" data-project data-category="saas">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=1200"
											alt="Syncro Team Flow"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Web Application • 2024</p>
										<h3 class="font-serif text-4xl">Syncro Team Flow</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-6" style="transition-delay: 500ms;" data-project data-category="fintech">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1200"
											alt="Zenith Cloud Infrastructure"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">SaaS Product • 2023</p>
										<h3 class="font-serif text-4xl">Zenith Cloud Infrastructure</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-4" data-project data-category="design">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&q=80&w=800"
											alt="Solara Energy Brand"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Branding • 2024</p>
										<h3 class="font-serif text-4xl">Solara Energy Brand</h3>
									</div>
								</div>
							</a>
						</div>

						<div class="scroll-zoom lg:col-span-8" data-project data-category="design">
							<a href="#" class="group block">
								<div class="hover-card relative overflow-hidden rounded-3xl bg-neutral-900">
									<div class="aspect-video w-full">
										<img
											src="https://images.unsplash.com/photo-1592478411213-6153e4ebc07d?auto=format&fit=crop&q=80&w=1600"
											alt="The VR Experience Hub"
											class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-110 group-hover:grayscale-0"
										/>
									</div>
									<div
										class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-transparent to-transparent p-10 opacity-0 transition-opacity group-hover:opacity-100"
									>
										<p class="mb-2 text-xs font-bold uppercase tracking-widest text-white/60">Immersive Web • 2024</p>
										<h3 class="font-serif text-4xl">The VR Experience Hub</h3>
									</div>
								</div>
							</a>
						</div>
					</div>
				</div>
			</main>

			<section class="relative overflow-hidden px-8 py-40">
				<div class="mx-auto max-w-7xl">
					<div class="glass scroll-zoom rounded-[3rem] p-20 text-center">
						<span class="text-muted mb-6 block text-xs font-black uppercase tracking-[0.5em]">READY TO START?</span>
						<h2 class="font-serif mb-12 text-6xl tracking-tighter md:text-8xl">
							Let's create something<br /><span class="text-outline italic">Extraordinary</span>
						</h2>
						<a
							href="/#contact"
							id="works-cta-contact"
							class="glass inline-flex items-center gap-6 rounded-full px-12 py-6 text-xs font-black uppercase tracking-widest transition-all hover:bg-white hover:text-black"
						>
							Work With Us
							<iconify-icon icon="lucide:arrow-right"></iconify-icon>
						</a>
					</div>
				</div>
			</section>
		</div>
	</div>

	<Footer />
</div>

<script is:inline>
	let ticking = false;
	const activated = new WeakSet();

	function activate(el, delayMs = 0) {
		if (!(el instanceof HTMLElement)) return;
		if (activated.has(el)) return;
		activated.add(el);
		el.style.transitionDelay = `${delayMs}ms`;
		el.classList.add('active');
	}

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) activate(entry.target, 0);
			});
		},
		{ threshold: 0.05, rootMargin: '0px 0px -50px 0px' },
	);

	document.querySelectorAll('.scroll-zoom').forEach((el) => revealObserver.observe(el));

	function revealOnLoad() {
		const vh = window.innerHeight;
		const els = Array.from(document.querySelectorAll('.scroll-zoom'));
		let i = 0;
		for (const el of els) {
			const rect = el.getBoundingClientRect();
			const inView = rect.bottom > 0 && rect.top < vh * 0.95;
			if (!inView) continue;
			activate(el, i * 70);
			i += 1;
		}
	}

	function update3D() {
		const scrollY = window.pageYOffset;
		const vh = window.innerHeight;

		document.querySelectorAll('.scroll-zoom').forEach((el) => {
			const rect = el.getBoundingClientRect();

			let progress = (vh - rect.top) / (vh * 0.7);
			progress = Math.min(Math.max(progress, 0), 1);

			const scale = 0.7 + progress * 0.3;
			const z = -500 + progress * 500;
			const y = 100 * (1 - progress);
			const rot = 15 * (1 - progress);

			let transform = `perspective(1500px) translate3d(0, ${y}px, ${z}px) scale(${scale}) rotateX(${rot}deg)`;
			el.style.transform = transform;
			el.style.opacity = Math.min(progress * 1.5, 1);
		});

		document.querySelectorAll('.parallax-layer').forEach((layer) => {
			const speed = Number.parseFloat(layer.getAttribute('data-speed')) || 0.1;
			layer.style.transform = `translate3d(0, ${scrollY * speed}px, 0)`;
		});

		const nav = document.querySelector('[data-site-nav]');
		const navInner = document.querySelector('[data-site-nav-inner]');
		if (nav instanceof HTMLElement && navInner instanceof HTMLElement) {
			if (scrollY > 100) {
				nav.classList.remove('mix-blend-difference');
				nav.classList.add('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.remove('py-10');
				navInner.classList.add('py-6');
			} else {
				nav.classList.add('mix-blend-difference');
				nav.classList.remove('bg-[#080808]/90', 'backdrop-blur-md');
				navInner.classList.add('py-10');
				navInner.classList.remove('py-6');
			}
		}

		ticking = false;
	}

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(update3D);
			ticking = true;
		}
	});

	// Filtering
	const buttons = Array.from(document.querySelectorAll('[data-filter]'));
	const projects = Array.from(document.querySelectorAll('[data-project]'));

	function applyFilter(filter) {
		for (const btn of buttons) {
			btn.classList.toggle('active', btn.getAttribute('data-filter') === filter);
		}

		for (const item of projects) {
			const cat = item.getAttribute('data-category');
			const show = filter === 'all' || cat === filter;
			item.style.display = show ? '' : 'none';
		}
	}

	for (const btn of buttons) {
		btn.addEventListener('click', () => applyFilter(btn.getAttribute('data-filter') || 'all'));
	}

	requestAnimationFrame(revealOnLoad);
	update3D();
</script>

