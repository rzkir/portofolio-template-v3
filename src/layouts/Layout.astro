---
import '../../globals.css';

type Props = {
	title?: string;
};

const { title = 'Zylo | 3D Creative Director Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://api.fontshare.com/v2/css?f[]=gambetta@400,500,600,700&f[]=satoshi@300,400,500,700,900&display=swap"
			rel="stylesheet"
		/>
		<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
